{
  "name": "billing-system-js",
  "version": "1.0.0",
  "description": "BPIOLS Billing System",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "test": "node --test tests/money.test.js tests/pricing.test.js tests/validators.test.js tests/costing.test.js tests/orderMath.test.js tests/auth.test.js tests/customerBalance.test.js tests/refundSettlement.test.js",
    "create-user": "node scripts/createUser.js",
    "build-frontend": "npm --prefix frontend run build",
    "build-frontend:electron": "npm --prefix frontend run build -- --mode electron",
    "electron": "electron electron/main.js",
    "electron:prod": "npm run build-frontend:electron && electron electron/main.js",
    "electron:build": "npm run build-frontend:electron && electron-builder --win"
  },
  "author": "Hassan",
  "license": "ISC",
  "build": {
    "appId": "com.bpiols.billing",
    "productName": "BPIOLS",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.0",
    "nodemon": "^3.1.14",
    "pdfkit": "^0.20.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  }
}
