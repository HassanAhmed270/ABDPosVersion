PORT=3000
# MONGO_URI=mongodb://localhost:27017/billing_system
NODE_ENV=development

# Cross-origin access (Stage 16) — comma-separated list of origins allowed
# to call this API from a different origin (Electron renderer, a separately
# hosted frontend). Same-origin production serving needs nothing here.
# Requests with no Origin header (same-origin, curl) always pass. The
# packaged Electron app (Stage 17) loads the UI via file://, which sends
# a literal "null" Origin header on fetches to the API — include it.
# Example for the Electron desktop build + Vite dev server:
# ALLOWED_ORIGINS=null,http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=

# Required — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_THIS_INSECURE_EXAMPLE_VALUE_DO_NOT_USE_IN_PRODUCTION
JWT_EXPIRES_IN=8h

LOG_LEVEL=info

# Draft bills (Stage 4) — how long an untouched cart sits before its
# reserved stock is released and it's marked abandoned, and how often the
# sweep checks. Defaults: 15 min idle timeout, checked every 60s.

DRAFT_IDLE_TIMEOUT_MS=900000
DRAFT_SWEEP_INTERVAL_MS=60000

# CSV export module (Stage 10). Set to "false" to disable/remove the
# feature entirely — see routes/export.js and lib/reports.js.
ENABLE_EXPORTS=true

# Offline sync module (Stage 11) — optional, off by default. Set to
# "true" to enable POST /api/sync/commit and the admin conflict queue.
# See routes/sync.js and lib/offlineSync.js.
ENABLE_OFFLINE_SYNC=true

# Audit log (Stage 14) — fixed-size ring buffer, not an unbounded log.
# Once the AuditLog collection reaches this many entries, each new write
# evicts the oldest one(s) so the total never grows past the cap. See
# lib/auditLog.js.
AUDIT_LOG_MAX_ENTRIES=5000
